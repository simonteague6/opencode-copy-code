  "description": "Preview and copy fenced assistant code blocks from the OpenCode TUI.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui"
  ],
  "homepage": "https://github.com/simonteague6/opencode-copy-code#readme",
